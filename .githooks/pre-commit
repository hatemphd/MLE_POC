#!/usr/bin/env bash
# Stamp the notebook with VERSION + today's date + branch, then re-stage it.
# Enabled once per clone with:  git config core.hooksPath .githooks
# Skip for one commit with:     git commit --no-verify
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
NOTEBOOK="TrustGate_SWEBench_PoC_ML_v3.ipynb"
PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY="python3"
"$PY" "$ROOT/pipeline/stamp_notebook.py" --notebook "$ROOT/$NOTEBOOK"
git -C "$ROOT" add "$NOTEBOOK"
